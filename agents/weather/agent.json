{
  "agent_id": "weather-agent",
  "name": "weather-agent",
  "version": "1.0.0",
  "description": "Weather data provider using OpenWeatherMap API",
  "url": "http://weather-agent:8000",
  "default_input_modes": ["application/json"],
  "default_output_modes": ["application/json"],
  "skills": [
    {
      "id": "get_weather",
      "name": "Get Weather",
      "description": "Retrieve current weather conditions for a specified city",
      "tags": ["weather"]
    }
  ],
  "capabilities": {},
  "capability_specs": [
    {
      "name": "get_weather",
      "description": "Get current weather for a city",
      "input_schema": {
        "type": "object",
        "properties": {
          "city": {"type": "string", "description": "City name"},
          "country_code": {"type": "string", "description": "Country code"}
        },
        "required": ["city", "country_code"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "city": {"type": "string"},
          "temperature": {"type": "number"},
          "description": {"type": "string"},
          "humidity": {"type": "number"}
        }
      }
    }
  ],
  "a2a_communication": {
    "protocol": "http",
    "endpoints": [{"path": "/weather", "method": "POST", "capability": "get_weather"}],
    "message_format": "json"
  }
}
