{
  "schema_version": "1.0",
  "name": "news-mcp",
  "description": "Model Context Protocol server that retrieves recent news articles using NewsAPI.",
  "entry": {
    "command": "python",
    "args": ["mcp-servers/news/server.py"],
    "working_directory": ".",
    "env": {
      "NEWS_API_KEY": "${NEWS_API_KEY}",
      "NEWS_MCP_TRANSPORT": "http",
      "NEWS_MCP_HOST": "0.0.0.0",
      "NEWS_MCP_PORT": "9000",
      "NEWS_MCP_SERVICE_NAME": "news-mcp"
    }
  },
  "transport": {
    "type": "http",
    "url": "${NEWS_MCP_URL:-http://news-mcp-service:9000/mcp}"
  },
  "capabilities": {
    "tools": ["get_news"]
  }
}
